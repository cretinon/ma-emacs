{
  "defaultModel": "deepseek/deepseek-v4-flash",
  "providers": {
    "google": {
      "key": "${env:GOOGLE_API_KEY}"
    },
    "deepseek": {
      "api": "openai-chat",
      "url": "https://api.deepseek.com",
      "key": "${env:DEEPSEEK_API_KEY}",
      "models": {
        "deepseek-v4-flash": {},
        "deepseek-v4-pro": {}
      }
    }
  },
  "mcpServers": {
    "mcp-bash": {
      "command": "/root/git/mcp/mcp_server.sh",
      "args": [],
      "env": {
        "MY_GIT_DIR": "/root/git",
        "DEBUG": "true"
      }
    },
    "storm-mcp": {
      "command": "/root/git/storm/storm-mcp.sh",
      "args": [],
      "env": {
        "MY_GIT_DIR": "/root/git",
        "DEBUG": "true"
      }
    }
  },
  "toolCall": {
    "approval": {
      "allow": {
        "mcp-bash": {},
        "storm-mcp": {},
        "eca__git": {},
        "eca__read_file": {
          "argsMatchers": {
            "path": ["/root/git/.*"]
          }
        }
      },
      "deny": {
        "eca__git": {
          "argsMatchers": {
            "command": [".*\\bgit\\s+push\\b.*"],
            "operation": ["push"]
          }
        }
      }
    }
  },
  "$schema": "https://eca.dev/config.json"
}
